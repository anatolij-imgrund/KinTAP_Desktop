<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:KinTAP.Controller"
            xmlns:conv="using:KinTAP.View.Converters" 
            xmlns:models="using:KinTAP.Model"
            xmlns:views="using:KinTAP.View"
            mc:Ignorable="d"
            d:DesignWidth="1100" 
            d:DesignHeight="900"
            x:Class="KinTAP.View.ParentView" 
            x:DataType="vm:ParentController"
            d:DataContext="{d:DesignInstance Type=vm:ParentController, IsDesignTimeCreatable=False}"
            FontFamily="Default">
    
    <UserControl.Resources>
        <conv:BooleanNegationConverter x:Key="BoolNegate"/>
        <conv:StatusToVisibilityConverter x:Key="StatusToVis"/>
        <conv:StatusToBackgroundConverter x:Key="StatusToBg"/>
        <conv:StatusToStringConverter x:Key="StatusToString"/>
        <conv:StringToBitmapConverter x:Key="StringToBitmapConv"/>
        <conv:RecurrenceTypeToStringConverter x:Key="RecurrenceTypeToString"/>
        <conv:TaskToOverdueVisibilityConverter x:Key="OverdueVis"/>
        <conv:TaskToAssignmentTypeStringConverter x:Key="TaskAssignmentTypeToString"/>
    </UserControl.Resources>

    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top"
                Background="LightSkyBlue"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,10">
			<Grid ColumnDefinitions="*, Auto, Auto">
				<TextBlock Grid.Column="0"
                                        Text="Elternpanel"
                                        FontSize="20"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"/>
                            
                <Button x:Name="ParentLogoutButton"
                        Grid.Column="2"
                        Content="⮌"
                        FontWeight="Bold"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"/>
			</Grid>
	    </Border>

    <TabControl>
        <TabItem Header="Kinder verwalten">
            <Grid ColumnDefinitions="Auto, *" Margin="0,5,0,5">
                <Border Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="0,0,5,0">
                <StackPanel Spacing="10" Width="300">
                    <TextBlock Text="Einen Kind hinzufügen" FontWeight="Bold"/>
                    <TextBlock Text="Name:"/>
                    <TextBox Text="{Binding NewChildName, Mode=TwoWay}"/>
                        <Border BorderBrush="Gray"
                                BorderThickness="1"
                                CornerRadius="3"
                                Width="250"
                                Height="250"
                                Margin="0,10,0,5"
                                IsVisible="{Binding IsEditingChild}">
                                <Image x:Name="ProfileImagePreview"
                                        Stretch="UniformToFill">
                                <Image.Source>
                                        <Binding Path="SelectedChild.ProfileImagePath"
                                                Converter="{StaticResource StringToBitmapConv}">
                                                <Binding.Converter>
                                                </Binding.Converter>
                                        </Binding>
                                </Image.Source>
                                </Image>
                        </Border>
                        <Button Content="Foto auswählen"
                                Command="{Binding SelectChildPhotoCommand}"
                                IsVisible="{Binding IsEditingChild}"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>

                    <Button Content="Kind hinzufügen"
                            Command="{Binding SaveChildCommand}"
                            IsVisible="{Binding IsEditingChild, Converter={StaticResource BoolNegate}}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Änderung speichern"
                            Command="{Binding SaveChildCommand}"
                            IsVisible="{Binding IsEditingChild}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Kind bearbeiten"
                            Command="{Binding EditChildCommand}"
                            IsVisible="{Binding IsEditingChild, Converter={StaticResource BoolNegate}}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Änderung abbrechen"
                            Command="{Binding CancelEditChildCommand}"
                            IsVisible="{Binding IsEditingChild}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Kind löschen"
                            Command="{Binding DeleteChildCommand}"
                            IsVisible="{Binding IsEditingChild, Converter={StaticResource BoolNegate}}"
                            Background="LightCoral"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="5,0,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Kinder:" FontWeight="Bold"
                                DockPanel.Dock="Top"
                                Margin="0,0,0,5"/>
                    <ListBox ItemsSource="{Binding Children}" 
                            SelectedItem="{Binding SelectedChild, Mode=TwoWay}"
                            VerticalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </Border>
            </Grid>
        </TabItem>


        <TabItem Header="Aufgaben erstellen">
            <Grid ColumnDefinitions="Auto, *" Margin="0,5,0,5">
                <Border Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="0,0,5,0">
                <StackPanel Spacing="10" Width="300">
            
                    <TextBlock Text="Aufgabe erstellen" FontWeight="Bold"/>
            
                    <TextBlock Text="Aufgabename:"/>
                    <TextBox Text="{Binding NewTaskTitle, Mode=TwoWay}"/>

                    <TextBlock Text="Beschreibung:"/>
                    <TextBox Text="{Binding NewTaskDescription, Mode=TwoWay}"
                            AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
            
                    <TextBlock Text="Punkten für Aufgabe:"/>
                    <TextBox Text="{Binding NewTaskPointsValue, Mode=TwoWay}"/>

                    <TextBlock Text="Priorität:"/>
                    <ComboBox ItemsSource="{Binding PriorityOptions}"
                                DisplayMemberBinding="{Binding DisplayName}"
                                SelectedValueBinding="{Binding Value}"
                                SelectedValue="{Binding SelectedTaskPriority, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Beginn (optional):"/>
                    <TimePicker SelectedTime="{Binding NewTaskStartTimeOfDay, Mode=TwoWay}"
                                ClockIdentifier="24HourClock"
                                MinuteIncrement="10"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Ende (optional):"/>
                    <TimePicker SelectedTime="{Binding NewTaskEndTimeOfDay, Mode=TwoWay}"
                                ClockIdentifier="24HourClock"
                                MinuteIncrement="10"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Stretch"/>

                    <TextBlock Text="Wiederholung:"/>
                    <ComboBox ItemsSource="{Binding RecurrenceTypeOptions}"
                                SelectedItem="{Binding NewTaskRecurrenceType, Mode=TwoWay}"
                                HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                                <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource RecurrenceTypeToString}}"/>
                                </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                <Border BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="5"
                        Margin="0,5,0,5"
                        IsVisible="{Binding IsWeeklyRecurrenceSelected}">
                        <StackPanel Spacing="5">
                                <TextBlock Text="Wochentage (für tägliche):"
                                        FontSize="11"/>
                                <WrapPanel Orientation="Horizontal"
                                        ItemWidth="55">
                                        <CheckBox Content="Mo"
                                                IsChecked="{Binding NewTaskRecurrenceMonday, Mode=TwoWay}"
                                                Margin="2"/>
                                        <CheckBox Content="Di"
                                                IsChecked="{Binding NewTaskRecurrenceTuesday, Mode=TwoWay}"
                                                Margin="2"/>
                                        <CheckBox Content="Mi"
                                                IsChecked="{Binding NewTaskRecurrenceWednesday, Mode=TwoWay}"
                                                Margin="2"/>
                                        <CheckBox Content="Do"
                                                IsChecked="{Binding NewTaskRecurrenceThursday, Mode=TwoWay}"
                                                Margin="2"/>
                                        <CheckBox Content="Fr"
                                                IsChecked="{Binding NewTaskRecurrenceFriday, Mode=TwoWay}"
                                                Margin="2"/>
                                        <CheckBox Content="Sa"
                                                IsChecked="{Binding NewTaskRecurrenceSaturday, Mode=TwoWay}"
                                                Margin="2"/>
                                        <CheckBox Content="So"
                                                IsChecked="{Binding NewTaskRecurrenceSunday, Mode=TwoWay}"
                                                Margin="2"/>
                                </WrapPanel>
                        </StackPanel>
                </Border>
                <Border BorderBrush="LightGray"
                        BorderThickness="1"
                        Padding="5"
                        Margin="0,5,0,5"
                        IsVisible="{Binding IsSpecificDateSelected}">
                        <StackPanel Spacing="5">
                                <TextBlock Text="Bestimmtes Datum (einmalig):"
                                        FontSize="11"/>
                                <DatePicker SelectedDate="{Binding NewTaskSpecificDueDate, Mode=TwoWay}"
                                        HorizontalAlignment="Stretch"
                                        BorderBrush="LightGray"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="3"/>
                        </StackPanel>
                </Border>

                    <Button Content="Aufgabe erstellen" 
                            Command="{Binding SaveTaskDefinitionCommand}"
                            IsVisible="{Binding IsEditingTaskDefinition, Converter={StaticResource BoolNegate}}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Änderung speichern"
                            Command="{Binding SaveTaskDefinitionCommand}"
                            IsVisible="{Binding IsEditingTaskDefinition}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Aufgabe bearbeiten"
                            Command="{Binding EditTaskDefinitionCommand}"
                            IsVisible="{Binding IsEditingTaskDefinition, Converter={StaticResource BoolNegate}}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Änderung abbrechen"
                            Command="{Binding CancelEditTaskDefinitionCommand}"
                            IsVisible="{Binding IsEditingTaskDefinition}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Aufgabe löschen"
                            Command="{Binding DeleteTaskDefinitionCommand}"
                            IsVisible="{Binding IsEditingTaskDefinition, Converter={StaticResource BoolNegate}}"
                            Background="LightCoral"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="5,0,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Aufgaben:" FontWeight="Bold"
                                DockPanel.Dock="Top"
                                Margin="0,0,0,5"/>
                    <ListBox ItemsSource="{Binding TaskDefinitions}"
                            SelectedItem="{Binding SelectedTaskDefinition, Mode=TwoWay}" 
                            VerticalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Title}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding PointsValue, StringFormat='({0} Punkte)'}"/>
                                    <TextBlock Text="{Binding Description}" Foreground="Gray" FontStyle="Italic"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </Border>
            </Grid>
        </TabItem>


        <TabItem Header="Aufgaben zuweisen">
            <Grid ColumnDefinitions="Auto, *" Margin="0,5,0,5">
                <Border Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="0,0,5,0">
                <StackPanel Spacing="10" Width="300">
                    <TextBlock Text="Kind:" FontWeight="Bold"/>
                    <ListBox ItemsSource="{Binding Children}"
                        SelectedItem="{Binding SelectedChild, Mode=TwoWay}"
                        Height="150">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Separator Margin="0,15,0,5"/>

                    <TextBlock Text="Aufgabe:"/>
                    <ComboBox ItemsSource="{Binding PriorityFilterOptions}"
                                SelectedItem="{Binding SelectedPriorityFilterItem, Mode=TwoWay}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,10"/>
                    <ComboBox ItemsSource="{Binding FilteredTaskDefinition}"
                            SelectedItem="{Binding SelectedTaskDefinition, Mode=TwoWay}"
                            DisplayMemberBinding="{Binding Title}"
                            PlaceholderText="Aufgabe auswählen"
                            HorizontalAlignment="Stretch"/>                    
                    <Button Content="Aufgabe zuweisen"
                            Command="{Binding AssignTaskCommand}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Aufgabe zurücksetzen"
                            Command="{Binding DeleteAssignedTaskCommand}"
                            Background="LightCoral"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="5,0,0,0">
                <Grid RowDefinitions="Auto, *, Auto">
                    <TextBlock Grid.Row="0" Text="zugewiesene Aufgaben:" FontWeight="Bold" DockPanel.Dock="Top" Margin="0,0,0,5"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredAssignedTasks}" 
                            SelectedItem="{Binding SelectedAssignedTask, Mode=TwoWay}"
                            VerticalAlignment="Stretch">

                        <ListBox.ItemTemplate >
                            <DataTemplate x:DataType="models:TaskItem">
                                <Border BorderBrush="{Binding Status, Converter={StaticResource StatusToBg}}"
                                        BorderThickness="5"
                                        CornerRadius="3"
                                        Padding="5"
                                        Margin="0">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0" 
                                                    Spacing="2"
                                                    VerticalAlignment="Center"                                                    
                                                    Margin="5,5,5,5">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding PointsValue, StringFormat='({0} Punkte)'}" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Description}" FontSize="14" Foreground="DarkSlateGray" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" 
                                                    Spacing="2"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource StatusToString}}"
                                                        FontSize="11" FontStyle="Italic" Foreground="DarkSlateGray" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Converter={StaticResource TaskAssignmentTypeToString}}"
                                                        FontSize="16" Foreground="DarkBlue"/>
                                            <TextBlock Text="(Abgelaufen)"
                                                        Foreground="Red"
                                                        FontSize="16"
                                                        FontStyle="Italic"
                                                        FontWeight="Bold"
                                                        IsVisible="{Binding Converter={StaticResource OverdueVis}}"/>                                        
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="10"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button Content="Ablehnen"
                                Command="{Binding RejectTaskCompletionCommand}"
                                Background="OrangeRed"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                        <Button Content="Bestätigen"
                                Command="{Binding ConfirmTaskCompletionCommand}"
                                Background="LightGreen"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>
                </Border>
            </Grid>
        </TabItem>


        <TabItem Header="Belohnungen erstellen">
            <Grid ColumnDefinitions="Auto, *" Margin="0,5,0,5">
                <Border Grid.Column="0"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="0,0,5,0">
                <StackPanel Spacing="10" Width="300">
                    <TextBlock Text="Belohnung hinzufügen" FontWeight="Bold"/>
                    <TextBlock Text="Belohnung:"/>
                    <TextBox Text="{Binding NewRewardName, Mode=TwoWay}"/>
                    <TextBlock Text="Beschreibung:"/>
                    <TextBox Text="{Binding NewRewardDescription, Mode=TwoWay}"
                            AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                    <TextBlock Text="Punkten für Belohnung:"/>
                    <TextBox Text="{Binding NewRewardCost, Mode=TwoWay}"/>
                    
                    <Button Content="Belohnung hinzufügen" 
                            Command="{Binding SaveRewardCommand}"
                            IsVisible="{Binding IsEditingReward, Converter={StaticResource BoolNegate}}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Änderung speichern"
                            Command="{Binding SaveRewardCommand}"
                            IsVisible="{Binding IsEditingReward}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Belohnung bearbeiten"
                            Command="{Binding EditRewardCommand}"
                            IsVisible="{Binding IsEditingReward, Converter={StaticResource BoolNegate}}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Änderung abbrechen"
                            Command="{Binding CancelEditRewardCommand}"
                            IsVisible="{Binding IsEditingReward}"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                    <Button Content="Belohnung löschen"
                            Command="{Binding DeleteRewardCommand}"
                            IsVisible="{Binding IsEditingReward, Converter={StaticResource BoolNegate}}"
                            Background="LightCoral"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"/>
                </StackPanel>
                </Border>
                <Border Grid.Column="1"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10"
                        Margin="5,0,0,0">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="Belohnungen:" FontWeight="Bold"
                                DockPanel.Dock="Top"/>
                    <ListBox ItemsSource="{Binding Rewards}" 
                            SelectedItem="{Binding SelectedReward, Mode=TwoWay}"
                            VerticalAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding Cost, StringFormat='({0} Punkte)'}"/>
                                    <TextBlock Text="{Binding Description}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
                </Border>
            </Grid>
        </TabItem>


        <TabItem Header="Belohnungen verwalten">
            <Border BorderBrush="LightGray"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10"
                    Margin="0,5,0,5">
            <Grid RowDefinitions="*, Auto" Margin="5,0,5,5">
                <ListBox Grid.Row="0"
                        ItemsSource="{Binding PendingClaims}"
                        SelectedItem="{Binding SelectedPendingClaim, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ClaimedRewardInfo">
                                <Grid ColumnDefinitions="auto, *, Auto, Auto"
                                        MinHeight="30"
                                        Width="600">
                                    <TextBlock Grid.Column="0"
                                                Text="{Binding ChildName}"
                                                FontWeight="Bold"
                                                FontSize="18"
                                                Margin="0,0,15,0"
                                                VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                                Text="{Binding RewardName}"
                                                FontSize="16"
                                                TextWrapping="Wrap"
                                                VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                                Text="{Binding ClaimedDate, StringFormat='{}{0:dd.MM.yy HH:mm}'}"
                                                Foreground="Gray"
                                                FontStyle="Italic"
                                                Margin="15,0,15,0"
                                                VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3"
                                                Text="{Binding Cost, StringFormat='({0} Punkte)'}"
                                                Foreground="Purple"
                                                VerticalAlignment="Center"/>
                                </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Grid.Row="1"
                        Content="Kind hat die Belohnung gekriegt"
                        Command="{Binding MarkRewardDeliveredCommand}"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0"/>
            </Grid>
            </Border>
        </TabItem>
    </TabControl>
    </DockPanel>
</UserControl>
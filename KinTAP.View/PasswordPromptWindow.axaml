<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="300"
        d:DesignHeight="150"
        x:Class="KinTAP.View.PasswordPromptWindow"
        xmlns:local="using:KinTAP.View"
        Title="Elternpanel Login"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner">

<StackPanel Orientation="Vertical">
        <Border BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="3"
                Margin="5">
        <StackPanel Orientation="Vertical"
                        Spacing="10"
                        Margin="5">
                <TextBlock Text="Password eingeben:"/>

                <TextBox x:Name="PasswordInput"
                         PasswordChar="*"
                         Watermark="Password"/>        

                <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        HorizontalAlignment="Right">

                <Button x:Name="OkButton"
                        Content="OK"
                        IsDefault="True"/>
                <Button x:Name="CancelButton"
                        Content="Ablehnen"
                        IsCancel="True"/>

                </StackPanel>
        </StackPanel>
        </Border>
        <Border BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="3"
                Margin="5">
                <StackPanel Orientation="Vertical"
                        Spacing="10"
                        Margin="5">
                        <TextBlock Name="PasswordInfo" Text=""/>
                        <TextBlock Text="Password ändern:"/>
                        <TextBox x:Name="NewPasswordInput"
                                PasswordChar="*"
                                Watermark="Neues Password"/>
                        <TextBox x:Name="NewPasswordConfirmationInput"
                                PasswordChar="*"
                                Watermark="Wiederholen"/>
                        <Button x:Name="SaveButton"
                                Content="Speichern"/>
                </StackPanel>
        </Border>
</StackPanel>
</Window>